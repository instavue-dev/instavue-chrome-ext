{
  "name": "instavue",
  "version": "2.4.0",
  "private": true,
  "description": "InstaVue - debug VueJS app in an instant. Chrome extension.",
  "scripts": {
    "build": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "serve": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --watch --mode development",
    "zip": "npm run build && cd ext && zip -r ../instavue-$npm_package_version.zip . -x '*.map'"
  },
  "dependencies": {
    "core-js": "^3.41.0",
    "lodash": "^4.17.21",
    "vue": "^2.7.16",
    "vuex": "^3.6.2",
    "vuex-persist": "^2.3.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.19",
    "@vue/cli-service": "~4.5.19",
    "vue-template-compiler": "^2.7.16"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
